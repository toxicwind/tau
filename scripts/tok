#!/usr/bin/env bun
/**
 * tok — Sovereign Native Fast Token Counter CLI
 *
 * Uses @tau/tau-natives (Rust utok) compiled in-binary tokenizer.
 * Zero network, zero Python runtime, zero CPython symbol errors.
 *
 * Supports:
 *   tok <file>
 *   tok "some string"
 *   echo "hello" | tok
 *   tok -v <file>  (verbose breakdown across model families)
 */
import { countTokens, Encoding } from "/home/toxic/estate/ranch/tau/packages/natives/native/index.js";
import { readFileSync, existsSync } from "node:fs";

async function main() {
  const args = process.argv.slice(2);
  let verbose = false;
  let selectedEncoding: Encoding = Encoding.O200kBase;
  const targets: string[] = [];

  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === "-v" || a === "--verbose") {
      verbose = true;
    } else if (a === "-e" || a === "--encoding") {
      const name = args[++i];
      if (name && name in Encoding) {
        selectedEncoding = (Encoding as any)[name];
      }
    } else if (a === "-h" || a === "--help") {
      console.log(`tok — Sovereign Native Token Counter (utok / Rust)

Usage:
  tok [options] [file | "text string"]
  cat file | tok [options]

Options:
  -v, --verbose        Show multi-model comparison (o200k, cl100k, qwen3, deepseek)
  -e, --encoding <enc> Select encoding (O200kBase, Cl100kBase, Qwen3, DeepSeekV3, ClaudeV5)
  -h, --help           Show this help message`);
      process.exit(0);
    } else {
      targets.push(a);
    }
  }

  let text = "";
  if (targets.length === 0) {
    // Read from stdin
    text = await Bun.stdin.text();
  } else {
    const target = targets.join(" ");
    if (existsSync(target)) {
      try {
        text = readFileSync(target, "utf8");
      } catch {
        text = target;
      }
    } else {
      text = target;
    }
  }

  const byteLen = Buffer.byteLength(text, "utf8");
  const charLen = text.length;
  const o200k = countTokens(text, Encoding.O200kBase);

  if (verbose) {
    const cl100k = countTokens(text, Encoding.Cl100kBase);
    const qwen = countTokens(text, Encoding.Qwen3);
    const deepseek = countTokens(text, Encoding.DeepSeekV3);
    console.log(`o200k_base: ${o200k.toLocaleString()} tokens | cl100k: ${cl100k.toLocaleString()} | qwen3: ${qwen.toLocaleString()} | deepseek: ${deepseek.toLocaleString()} | bytes: ${byteLen.toLocaleString()} | chars: ${charLen.toLocaleString()}`);
  } else {
    console.log(o200k);
  }
}

main().catch((err) => {
  console.error("tok error:", err);
  process.exit(1);
});
