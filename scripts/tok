#!/usr/bin/env bun
/**
 * tok — Sovereign Native Fast Token Counter CLI
 *
 * Uses @tau/tau-natives (Rust utok) compiled in-binary tokenizer.
 * Zero network, zero Python runtime, zero CPython symbol errors.
 *
 * Supports:
 *   tok <file> [<file> ... <dir> ...]   per-file counts + total
 *   tok "some string"                   count an inline string
 *   echo "hello" | tok                  count stdin
 *   tok -v <target>                     multi-encoding breakdown
 *   tok -t 20 <dir>                     top-20 files by tokens
 *   tok --json <dir>                    machine-readable output
 *   tok --cost <target>                 rough $ cost per model family
 */
import { countTokens, Encoding } from "/home/toxic/estate/ranch/tau/packages/natives/native/index.js";
import * as fs from "node:fs/promises";
import * as path from "node:path";

const ENCODING_NAMES = Object.keys(Encoding).filter((k) => isNaN(Number(k)));
const MAX_FILE_BYTES = 64 * 1024 * 1024;
const MAX_DIR_FILES = 20_000;

// Rough input price per 1M tokens (USD) — keyed by encoding family.
const COST_PER_MTOK: Record<string, { model: string; price: number }> = {
	O200kBase: { model: "gpt-4o-class", price: 2.5 },
	Cl100kBase: { model: "gpt-4-turbo-class", price: 10.0 },
	ClaudeV5: { model: "claude-v5-class", price: 5.0 },
	ClaudeV47: { model: "claude-4.7-class", price: 5.0 },
	ClaudeV3: { model: "claude-3-class", price: 3.0 },
	Qwen3: { model: "qwen3-class", price: 0.5 },
	DeepSeekV3: { model: "deepseek-v3-class", price: 0.27 },
	KimiK2: { model: "kimi-k2-class", price: 0.6 },
	Glm5: { model: "glm5-class", price: 0.6 },
};

type EncodingName = string;

interface FileCount {
	path: string;
	tokens: number;
	bytes: number;
	chars: number;
	error?: string;
}

function parseEncodingName(raw: string): EncodingName | null {
	const upper = raw.toUpperCase();
	for (const name of ENCODING_NAMES) {
		if (name.toUpperCase() === upper) return name;
	}
	// friendly aliases
	const aliases: Record<string, string> = {
		O200K: "O200kBase",
		O200K_HARMONY: "O200kBase",
		HARMONY: "O200kBase",
		CL100K: "Cl100kBase",
		QWEN: "Qwen3",
		DEEPSEEK: "DeepSeekV3",
		CLAUDE: "ClaudeV5",
		GLM: "Glm5",
		KIMI: "KimiK2",
		JEV: "Jev",
	};
	const alias = aliases[upper];
	return alias ?? null;
}

async function collectFiles(target: string, out: string[], depth = 0): Promise<void> {
	if (out.length >= MAX_DIR_FILES) return;
	let st;
	try {
		st = await fs.stat(target);
	} catch {
		out.push(target); // nonexistent — counted as error later
		return;
	}
	if (st.isFile()) {
		out.push(target);
		return;
	}
	if (!st.isDirectory() || depth > 12) return;
	let entries;
	try {
		entries = await fs.readdir(target, { withFileTypes: true });
	} catch (err) {
		return;
	}
	entries.sort((a, b) => a.name.localeCompare(b.name));
	for (const e of entries) {
		if (out.length >= MAX_DIR_FILES) return;
		const p = path.join(target, e.name);
		if (e.isDirectory()) {
			if (e.name === "node_modules" || e.name === ".git") continue;
			await collectFiles(p, out, depth + 1);
		} else if (e.isFile()) {
			out.push(p);
		}
	}
}

function fmt(n: number): string {
	return n.toLocaleString("en-US");
}

async function readText(p: string): Promise<{ text: string; bytes: number } | { error: string }> {
	try {
		const st = await fs.stat(p);
		if (st.size > MAX_FILE_BYTES) {
			return { error: `skipped: ${fmt(st.size)} bytes > ${fmt(MAX_FILE_BYTES)} cap (use a pipe for giant inputs)` };
		}
		const buf = await fs.readFile(p);
		const text = buf.toString("utf8");
		return { text, bytes: st.size };
	} catch (err) {
		return { error: `unreadable: ${(err as Error).message}` };
	}
}

function usage(): string {
	return `tok — Sovereign Native Token Counter (utok / Rust, via @tau/tau-natives)

Usage:
  tok [options] [file | dir | "text string"] ...
  cat file | tok [options]

Counts every target: files get per-file lines + a total; directories are
walked recursively (node_modules/.git skipped); multiple targets aggregate;
a lone non-path argument is counted as an inline string; no targets reads stdin.

Options:
  -v, --verbose          Multi-encoding breakdown (all ${ENCODING_NAMES.length} families)
  -e, --encoding <name>  Encoding (default O200kBase). Valid: ${ENCODING_NAMES.join(", ")}
  -t, --top <N>          With multiple files: show only the N heaviest, then total
  --cost                 Estimate input cost in USD per model family
  --json                 JSON output (paths, tokens, bytes, chars, total)
  -h, --help             This help

Examples:
  tok main.ts                      # 2171
  tok -v notes.md                  # o200k/cl100k/qwen3/deepseek/kimi/glm/claude...
  tok -e Glm5 src/                 # GLM-5 token count for a whole tree
  tok --top 10 --cost ~/project    # biggest files + rough $ to ingest
`;
}

async function main() {
	const args = process.argv.slice(2);
	let verbose = false;
	let wantJson = false;
	let wantCost = false;
	let topN = 0;
	let encodingName: EncodingName = "O200kBase";
	const targets: string[] = [];

	for (let i = 0; i < args.length; i++) {
		const a = args[i];
		if (a === "-v" || a === "--verbose") {
			verbose = true;
		} else if (a === "--json") {
			wantJson = true;
		} else if (a === "--cost") {
			wantCost = true;
		} else if (a === "-t" || a === "--top") {
			topN = Number(args[++i]);
			if (!Number.isFinite(topN) || topN < 1) {
				console.error("tok: --top needs a positive number");
				process.exit(2);
			}
		} else if (a === "-e" || a === "--encoding") {
			const raw = args[++i];
			const resolved = raw ? parseEncodingName(raw) : null;
			if (!resolved) {
				console.error(`tok: unknown encoding ${raw ?? "(missing)"} — valid: ${ENCODING_NAMES.join(", ")}`);
				process.exit(2);
			}
			encodingName = resolved;
		} else if (a === "-h" || a === "--help") {
			console.log(usage());
			process.exit(0);
		} else {
			targets.push(a);
		}
	}

	const selected = Encoding[encodingName as keyof typeof Encoding];
	let text = "";
	let stdinLabel = "<stdin>";

	// Classify targets: existing paths (files/dirs) vs inline strings.
	const paths: string[] = [];
	const strings: string[] = [];
	for (const t of targets) {
		const isPath = await fs.stat(t).then(() => true).catch(() => false);
		if (isPath) paths.push(t);
		else strings.push(t);
	}

	// Single inline string or stdin (fast path, preserves original behavior)
	if (paths.length === 0) {
		if (strings.length === 1) {
			text = strings[0];
			stdinLabel = "<string>";
		} else if (strings.length === 0) {
			text = await Bun.stdin.text();
		} else {
			text = strings.join(" ");
			stdinLabel = `<${strings.length} strings>`;
		}
		const bytes = Buffer.byteLength(text, "utf8");
		if (verbose) {
			const parts = ENCODING_NAMES.map((name) => `${name}: ${fmt(countTokens(text, Encoding[name as keyof typeof Encoding]))}`);
			console.log(`${parts.join(" | ")} | bytes: ${fmt(bytes)} | chars: ${fmt(text.length)}`);
		} else if (wantJson) {
			console.log(JSON.stringify({ encoding: encodingName, label: stdinLabel, tokens: countTokens(text, selected), bytes, chars: text.length }));
		} else {
			console.log(fmt(countTokens(text, selected)));
		}
		if (wantCost) {
			const prices = verbose ? Object.entries(COST_PER_MTOK) : [[encodingName, COST_PER_MTOK[encodingName]] as [string, { model: string; price: number } | undefined]];
			for (const [name, info] of prices) {
				if (!info) {
					console.log(`no price table entry for ${name}`);
					continue;
				}
				const t = countTokens(text, Encoding[name as keyof typeof Encoding]);
				console.log(`  ~$${((t / 1_000_000) * info.price).toFixed(4)} as ${info.model} ($${info.price}/Mtok in, ${name})`);
			}
		}
		return;
	}

	// Multi-target path: expand dirs, count per file, aggregate.
	const files: string[] = [];
	for (const p of paths) await collectFiles(p, files);

	const results: FileCount[] = [];
	let hadError = false;
	for (const s of strings) {
		results.push({ path: `<string ${results.length + 1}: "${s.length > 40 ? `${s.slice(0, 37)}..."` : s}">`, tokens: countTokens(s, selected), bytes: Buffer.byteLength(s, "utf8"), chars: s.length });
	}
	for (const f of files) {
		const r = await readText(f);
		if ("error" in r) {
			results.push({ path: f, tokens: 0, bytes: 0, chars: 0, error: r.error });
			hadError = true;
			continue;
		}
		results.push({
			path: f,
			tokens: countTokens(r.text, selected),
			bytes: r.bytes,
			chars: r.text.length,
		});
	}

	const totalTokens = results.reduce((s, r) => s + r.tokens, 0);
	const totalBytes = results.reduce((s, r) => s + r.bytes, 0);
	const totalChars = results.reduce((s, r) => s + r.chars, 0);

	if (wantJson) {
		console.log(JSON.stringify({ encoding: encodingName, files: results, total: { tokens: totalTokens, bytes: totalBytes, chars: totalChars } }));
		if (hadError) process.exitCode = 1;
		return;
	}

	const sorted = [...results].sort((a, b) => b.tokens - a.tokens);
	const shown = topN > 0 ? sorted.slice(0, topN) : sorted;
	const width = Math.max(...shown.map((r) => fmt(r.tokens).length), 6);
	const pathWidth = Math.max(...shown.map((r) => r.path.length), 5 + (topN > 0 ? 0 : 0));
	for (const r of shown) {
		const label = r.error ? `${r.path}  (${r.error})` : r.path;
		console.log(`${fmt(r.tokens).padStart(width)}  ${label}`);
	}
	if (topN > 0 && sorted.length > topN) {
		console.log(`${"...".padStart(width)}  (${sorted.length - topN} more files)`);
	}
	if (results.length > 1) {
		console.log(`${"-".repeat(width + 2 + Math.min(pathWidth, 40))}`);
		console.log(`${fmt(totalTokens).padStart(width)}  TOTAL  (${results.length} files, ${fmt(totalBytes)} bytes, ${fmt(totalChars)} chars)`);
	}
	if (verbose) {
		console.log(`encodings: ${ENCODING_NAMES.join(", ")} — re-run with -e <name> for another family's counts`);
	}
	if (wantCost) {
		const info = COST_PER_MTOK[encodingName];
		if (info) {
			console.log(`~$${((totalTokens / 1_000_000) * info.price).toFixed(4)} to ingest as ${info.model} ($${info.price}/Mtok in, ${encodingName})`);
		} else {
			console.log(`no price table entry for ${encodingName}`);
		}
	}
	if (hadError) process.exitCode = 1;
}

main().catch((err) => {
	console.error("tok error:", err);
	process.exit(1);
});
