{
  "type": "module",
  "private": true,
  "name": "@tau/tau-metaharness",
  "version": "0.0.1",
  "description": "Unified benchmark runners plus Harbor run storage, REST/SSE APIs, and a live web dashboard",
  "homepage": "https://tau.sh",
  "author": {
    "name": "Stencil Labs, Inc.",
    "url": "https://stencil.so"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toxicwind/tau.git",
    "directory": "packages/metaharness"
  },
  "bin": {
    "metaharness": "src/server.ts"
  },
  "scripts": {
    "check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && bun run check:types",
    "check:types": "bun ../../scripts/typecheck.ts . --noEmit && bun ../../scripts/typecheck.ts src/tb --noEmit && bun ../../scripts/typecheck.ts adapters/edit --noEmit && bun ../../scripts/typecheck.ts scripts --noEmit",
    "lint": "oxlint .",
    "serve": "bun run src/server.ts",
    "bench:edit": "bun adapters/edit/cli.ts",
    "bench:tb": "bun src/tb/cli.ts",
    "bench:tb-floor": "bun scripts/tb-floor.ts",
    "dev": "bun --hot src/server.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@tau/tau-agent-core": "catalog:",
    "@tau/tau-ai": "catalog:",
    "@tau/tau-catalog": "catalog:",
    "tau": "workspace:*",
    "@tau/tau-utils": "catalog:",
    "@tau/typescript-edit-benchmark": "workspace:*",
    "@stencil-hq/vibemon": "^0.3.2",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "diff": "catalog:",
    "@tau/tau-natives": "catalog:",
    "motion": "^12.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react-refresh": "^0.18.0"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
