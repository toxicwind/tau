{
  "type": "module",
  "private": true,
  "name": "@tau/typescript-edit-benchmark",
  "version": "0.0.1",
  "description": "Edit benchmark suite using TypeScript source code mutations",
  "homepage": "https://tau.sh",
  "author": {
    "name": "Stencil Labs, Inc.",
    "url": "https://stencil.so"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toxicwind/tau.git",
    "directory": "packages/typescript-edit-benchmark"
  },
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./*.js": "./src/*.ts"
  },
  "scripts": {
    "check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "lint": "oxlint .",
    "test": "bun test --parallel",
    "fix": "oxlint --fix --fix-suggestions . && bun run fmt",
    "fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts'",
    "generate": "bun run src/generate.ts --typescript-dir /tmp/tau-mono-source",
    "edit-shapes": "bun run src/edit-shape-stats.ts"
  },
  "dependencies": {
    "@babel/generator": "catalog:",
    "@babel/parser": "catalog:",
    "@babel/traverse": "catalog:",
    "@babel/types": "catalog:",
    "@tau/tau-agent-core": "catalog:",
    "@tau/tau-coding-agent": "workspace:*",
    "@tau/tau-utils": "catalog:",
    "diff": "catalog:",
    "@tau/tau-natives": "catalog:",
    "prettier": "catalog:",
    "regexp-tree": "catalog:",
    "@tau/tau-ai": "catalog:",
    "@tau/tau-tui": "catalog:"
  },
  "devDependencies": {
    "@types/babel__generator": "catalog:",
    "@types/babel__traverse": "catalog:",
    "@types/bun": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
