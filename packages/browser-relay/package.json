{
	"type": "module",
	"name": "@tau/browser-relay",
	"version": "0.1.0",
	"private": true,
	"description": "Chrome extension that lets the tau browser tool drive your existing tabs (relay server lives in the tau CLI: `tau browser-relay`)",
	"homepage": "https://tau.sh",
	"author": { "name": "Stencil Labs, Inc.", "url": "https://stencil.so" },
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/toxicwind/tau.git",
		"directory": "packages/browser-relay"
	},
	"scripts": {
		"build": "bun scripts/build-extension.ts",
		"check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && bun run check:types",
		"check:types": "bun ../../scripts/typecheck.ts . --noEmit",
		"lint": "oxlint .",
		"fix": "oxlint --fix --fix-suggestions . && bun run fmt",
		"fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts'"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"puppeteer-core": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
