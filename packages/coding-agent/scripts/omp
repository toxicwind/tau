#!/usr/bin/env bash
# First-class sovereign omp runner — prefers compiled maximal binary (dist/omp), falls back to dev runner
set -euo pipefail
FORK_ROOT="$HOME/sovereign/projects/tau/packages/coding-agent"
COMPILED="$FORK_ROOT/dist/omp"
DEV_SCRIPT="$FORK_ROOT/scripts/omp"

if [ -x "$COMPILED" ] && [ -z "${OMP_DEV_MODE:-}" ]; then
  exec "$COMPILED" "$@"
elif [ -x "$DEV_SCRIPT" ]; then
  exec "$DEV_SCRIPT" "$@"
else
  echo "omp: no executable compiled binary or dev script found" >&2
  exit 127
fi
