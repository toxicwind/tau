@@ -0,0 +1,493 @@
+import { describe, expect, it, vi } from "vitest";
+
+const { MockInput, mockMatchesKey } = vi.hoisted(() => {
+	class Input {
+		value = "";
+		onSubmit?: (submitted: string) => void;
+		onEscape?: () => void;
+		handleInput(data: string) {
+			if (data === "\r" || data === "\u001b[13u") {
+				this.onSubmit?.(this.value);
+				return;
+			}
+			if (data === "\x1b" || data === "\u001b[27u" || data === "\u001b[27;1;27~") {
+				this.onEscape?.();
+				return;
+			}
+			if (data === "\x7f" || data === "\u001b[127u" || data === "") {
+				this.value = this.value.slice(0, -1);
+			} else if (data === "\x15") {
+				this.value = "";
+			} else if (data === "\x03" || data.startsWith("\u001b")) {
+				// control keys
+			} else {
+				this.value += data;
+			}
+		}
+		setValue(val: string) { this.value = val; }
+		getValue() { return this.value; }
+		render(_width = 80): string[] { return [`> ${this.value}`]; }
+	}
+	const keyMap: Record<string, string> = {
+		"\t": "tab",
+		"\r": "enter",
+		"\x1b": "escape",
+		"\x15": "ctrl+u",
+		"\x03": "ctrl+c",
+		" ": "space",
+		"[": "[",
+		"]": "]",
+		"j": "j",
+		"k": "k",
+		"s": "s",
+		"q": "q",
+		"OVERLAP": "OVERLAP",
+	};
+	const matchesKey = (data: string, key: string) => {
+		if (key === "left") return data === "[" || data === "\u001b[D" || data === "\u001bOD" || data === "\u001b[57417u" || data === "\u001b[1;1D";
+		if (key === "right") return data === "\t" || data === "]" || data === "\u001b[C" || data === "\u001bOC" || data === "\u001b[57418u" || data === "\u001b[1;1C" || data === "\u001b[9u";
+		if (key === "up") return data === "k" || data === "\u001b[A" || data === "\u001bOA" || data === "\u001b[57419u" || data === "\u001b[1;1A";
+		if (key === "down") return data === "j" || data === "\u001b[B" || data === "\u001bOB" || data === "\u001b[57420u" || data === "\u001b[1;1B";
+		if (key === "enter") return data === "\r" || data === "\u001b[13u";
+		if (key === "escape") return data === "\x1b" || data === "\u001b[27u" || data === "\u001b[27;1;27~";
+		if (key === "ctrl+c") return data === "\x03";
+		if (key === "space") return data === " " || data === "\u001b[32u";
+		if (key === "shift+tab") return false;
+		return keyMap[data] === key;
+	};
+	return { MockInput: Input, mockMatchesKey: matchesKey };
+});
+vi.mock("@oh-my-pi/pi-tui", () => ({ Input: MockInput, matchesKey: mockMatchesKey }));
