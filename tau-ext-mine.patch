+								probeRetry++;
+								const backoffMs = 5_000 * 2 ** (probeRetry - 1); // 5s, 10s
+								if (state.currentConfig.debug) {
+									console.log(
+										`[model-router] stream stalled on ${modelRef} — probing provider (attempt ${probeRetry}/${PROBE_MAX_RETRIES}, backoff ${backoffMs / 1000}s)`,
+									);
+								}
