      "tags": [
        "git",
        "commits",
        "workflow",
        "hunk",
        "review"
      ],
      "source": "./plugins/omp-edit-committer",
      "homepage": "https://github.com/toxicwind/estate-scripts-projects/tree/main/ranch/tau-marketplace/plugins/omp-edit-committer",
