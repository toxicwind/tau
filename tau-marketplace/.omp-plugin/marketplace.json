{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "tau-marketplace",
  "owner": {
    "name": "toxicwind",
    "email": "toxicwind@users.noreply.github.com"
  },
  "metadata": {
    "description": "Official estate-scripts Estate Marketplace for Tau & Oh-My-Pi extensions, plugins, and ambient tools",
    "version": "1.0.0",
    "homepage": "https://github.com/toxicwind/estate-scripts-projects/tree/main/ranch/tau-marketplace",
    "pluginRoot": "plugins"
  },
  "plugins": [
    {
      "name": "omp-mobile-autocorrect",
      "version": "1.0.0",
      "description": "In-process MITM spatial QWERTY autocorrect middleware for Termux, Android keyboard slips, and touchscreens",
      "category": "mobile",
      "tags": [
        "autocorrect",
        "termux",
        "qwerty",
        "touchscreen",
        "mitm",
        "ergonomics"
      ],
      "source": "./plugins/omp-mobile-autocorrect",
      "homepage": "https://github.com/toxicwind/estate-scripts-projects/tree/main/ranch/tau-marketplace/plugins/omp-mobile-autocorrect",
      "license": "MIT"
    },
    {
      "name": "vansrouter",
      "version": "1.0.0",
      "description": "OpenAI-compatible local model provider with live catalog sync from VansRouter (:20128)",
      "category": "model-provider",
      "tags": [
        "vansrouter",
        "provider",
        "local-models",
        "catalog",
        "routing"
      ],
      "source": "./plugins/vansrouter",
      "homepage": "https://github.com/toxicwind/estate-scripts-projects/tree/main/ranch/tau-marketplace/plugins/vansrouter",
      "license": "MIT"
