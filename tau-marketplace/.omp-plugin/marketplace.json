    {
      "name": "tau-loops",
      "version": "1.0.0",
      "description": "Bounded diagnostic and audit loops (/loop-model-audit, /loop-dir-diff, /loop-probe) for fleet verification",
      "category": "diagnostics",
      "tags": [
        "loops",
        "audit",
        "diagnostics",
        "model-audit",
        "diff"
      ],
      "source": "./plugins/tau-loops",
      "homepage": "https://github.com/toxicwind/estate-scripts-projects/tree/main/ranch/tau-marketplace/plugins/tau-loops",
