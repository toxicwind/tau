      "tags": [
        "model-router",
        "routing",
        "classifier",
        "fallback",
        "tokens"
      ],
      "source": "./plugins/omp-model-router",
      "homepage": "https://github.com/toxicwind/estate-scripts-projects/tree/main/ranch/tau-marketplace/plugins/omp-model-router",
